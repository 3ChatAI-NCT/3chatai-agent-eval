# Copy to .env and provide your own values. No service addresses or credentials are bundled.
# Development authentication is for loopback-only use.
EVAL_ENVIRONMENT=development
EVAL_DEV_IDENTITY=true
EVAL_DATABASE_URL=
EVAL_STORAGE_BACKEND=local
EVAL_OBJECT_ROOT=.local/objects

# Gateway authentication (required for a production installation)
EVAL_INTERNAL_TENANT_ID=
EVAL_MEMBER_STAFF_IDS=[]
EVAL_PUBLIC_ORIGIN=
EVAL_GATEWAY_TOKEN=
EVAL_CREDENTIAL_KEY=

# Model gateway, entitlement, and execution-model mapping
EVAL_MODEL_GATEWAY_URL=
EVAL_ENTITLEMENT_URL=
EVAL_ENTITLEMENT_PRODUCT_SOURCE=
EVAL_MODEL_MAPPING_URL=
EVAL_MAPPING_FROM_MODEL=
EVAL_JUDGE_MODEL=
EVAL_ANNOTATION_MODEL=

# Platform API and image preview: exact trusted hostnames, comma-separated; empty denies previews.
EVAL_PLATFORM_BASE_URL=
EVAL_MEDIA_ALLOWED_HOSTS=

# Feishu app and workspace registry
EVAL_FEISHU_APP_ID=
EVAL_FEISHU_APP_SECRET=
EVAL_FEISHU_BASE_APP_TOKEN=
EVAL_FEISHU_BASE_TABLE_ID=
EVAL_FEISHU_BASE_VIEW_ID=

# OSS storage (required when EVAL_STORAGE_BACKEND=oss)
EVAL_OSS_ENDPOINT=
EVAL_OSS_BUCKET=
EVAL_OSS_PREFIX=3chat-agent-eval/
EVAL_OSS_ACCESS_KEY_ID=
EVAL_OSS_ACCESS_KEY_SECRET=
EVAL_OSS_SECURITY_TOKEN=

# SLS collection and traces: export these in the process environment (read-only credentials)
SLS_ENDPOINT=
SLS_PROJECT=
SLS_LOGSTORE=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
